# Name and email sent to the SEC in the User-Agent header (the SEC rejects requests without it).
# The email is also sent to Unpaywall, which requires one to look up open-access papers.
BIOSIGNAL_CONTACT="Your Name your-email@example.com"

# Optional: where the collected data goes. Default: data_collection/ in the repository (ignored by git).
# BIOSIGNAL_DATA=/path/to/data_collection
